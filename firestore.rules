rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'luiz.uehara1@gmail.com' ||
        request.auth.token.email == 'lopesvinicius199@gmail.com' ||
        request.auth.token.email == 'fabriciocosta54964@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email))
      );
    }

    match /numeros/{numeroId} {
      allow read: if true;
      allow create, update: if isAdmin() || isSignedIn();
    }

    match /rifas/{rifaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pedidos/{pedidoId} {
      allow read, write: if true;
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
